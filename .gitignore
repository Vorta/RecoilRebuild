# RecoilRebuild public source-only ignore policy.
#
# Keep every maintained authored source, tool, test, manifest, skill, and
# operational document visible to Git. Keep only provider inputs, machine-local
# state, and generated output local.

# Local/private original inputs and extracted assets
/support/
/playground/
img/
resources/raw/
*.bndb
*.bnpm
*.idb
*.i64
*.nrg
*.iso
*.rar
*.7z
*.zip
*.zbd
.devspace/

# SQLite transient files. Canonical *.sqlite3 ledgers remain eligible.
*.sqlite3-journal
*.sqlite3.migration-tmp
*.sqlite3

# Build output and generated verification artifacts
build/
artifacts/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
MCP/
_scratch/

# Native/compiler/linker output
*.aps
*.binlog
*.cache
*.cod
*.coverage
*.coveragexml
*.dll
*.exe
*.exp
*.iobj
*.ilk
*.ipdb
*.lib
*.map
*.meta
*.ncb
*.obj
*.opendb
*.opensdf
*.pch
*.pdb
*.pgc
*.pgd
*.plg
*.res
*.rsp
!Directory.Build.rsp
*.sbr
*.sdf
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj

# Test and coverage output
TestResults/
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio and IDE state
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user
*.code-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.localhistory/
.history/
.vshistory/

# Legacy Visual Studio workspace/project side files
*.dsw
*.dsp
*.opt
*.vbw
*.vbp
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
MigrationBackup/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# AI/local assistant runtime state. Canonical `.codex/skills/recoil-*`, pointer
# mirrors under `.claude/`, AGENTS.md, and CLAUDE.md are maintained authored
# workspace files and therefore are not broadly ignored.
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
.codex/skills/*
!.codex/skills/recoil-*/
!.codex/skills/recoil-*/**
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/skills/
.claude/skills/*
!.claude/skills/recoil-*/
!.claude/skills/recoil-*/**
!.claude/settings.json
.cursor/
.agent/claims/

# Transient cross-ledger reservation mutex.
/.agent/.recoil-cross-ledger-reservation.revision.lock

# OS/editor temporary files
Thumbs.db
Desktop.ini
~$*
*~
*.swp
*.swo

# Exact generated tool/test roots; authored files elsewhere under tools/ and
# tests/tools/ are tracked.
/tools/.devspace/
/tools/vc5_verify_bn_cache/
/tools/build/
/tests/tools/build/
/tools/diagnostics/
/tests/tools/diagnostics/
/temp/
