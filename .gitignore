# Public source repository: only game code and reader-facing documentation.
/*
!/.gitignore
!/.gitattributes
!/.clang-format
!/LICENSE
!/README.md
!/src/
!/src/**
!/docs/
!/docs/**
/docs/reconstruction/
/src/native/

# Generated/compiler output is never public source.
*.obj
*.exe
*.dll
*.lib
*.pdb
*.res
*.pch
*.map
*.cod
*.tmp
*.sqlite3
*.bndb
__pycache__/
