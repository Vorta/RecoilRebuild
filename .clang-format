BasedOnStyle: LLVM

IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100

AllowShortFunctionsOnASingleLine: Empty
SortIncludes: CaseSensitive

# Use block-style continuation indentation instead of aligning later
# parameters/arguments under the first one.
AlignAfterOpenBracket: DontAlign
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true

# Once a call wraps, put one argument per line.
BinPackArguments: false
AllowAllArgumentsOnNextLine: false

# Function definitions: force a break before parameters.
BreakFunctionDefinitionParameters: true

# Parameters: always one per line.
BinPackParameters: AlwaysOnePerLine
AllowAllParametersOfDeclarationOnNextLine: false

# Explicit, although LLVM already attaches function braces.
BreakBeforeBraces: Attach
